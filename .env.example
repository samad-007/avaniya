# ==============================================================================
# AVANIYA REAL ESTATE TRACKER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file and rename it to `.env.local`
# 2. Replace the placeholder values with your real MongoDB Atlas credentials
# 3. NEVER commit your actual `.env.local` file to Git (it is blocked in .gitignore)
# ==============================================================================

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas -> Database -> Connect -> Drivers -> Node.js
# Example: mongodb+srv://dbUser:dbPassword@cluster0.abcde.mongodb.net/real_estate_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/real_estate_tracker?retryWrites=true&w=majority

# JWT Session Secret Key
# Generate a secure 64-character random string (e.g. using `openssl rand -base64 32`)
JWT_SECRET=your_super_secret_jwt_encryption_key_here_min_32_characters

# Environment Runtime Mode
NODE_ENV=development
